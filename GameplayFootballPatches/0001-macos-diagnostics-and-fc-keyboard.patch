diff --git a/src/hid/keyboard.cpp b/src/hid/keyboard.cpp
--- a/src/hid/keyboard.cpp
+++ b/src/hid/keyboard.cpp
@@ -28,3 +28,10 @@ void HIDKeyboard::LoadConfig() {
     functionMapping[i] = (SDL_Keycode)GetConfiguration()->GetInt(("input_keyboard_" + int_to_str(i)).c_str(), (SDL_Keycode)defaultKeyIDs[i]);
   }
+  // The two official FC Online defensive presets use different meanings for
+  // S/Q/D. Keep attack mappings intact and only override defensive actions.
+  if (GetConfiguration()->Get("siu_defense_mode", "tactical") == "basic") {
+    functionMapping[e_ButtonFunction_Switch] = SDLK_s;
+    functionMapping[e_ButtonFunction_Pressure] = SDLK_d;
+    functionMapping[e_ButtonFunction_TeamPressure] = SDLK_q;
+  }
 }
diff --git a/src/managers/usereventmanager.cpp b/src/managers/usereventmanager.cpp
--- a/src/managers/usereventmanager.cpp
+++ b/src/managers/usereventmanager.cpp
@@ -83,6 +83,12 @@ void UserEventManager::InputSDLEvent(const SDL_Event &event) {
         keyPressed.erase(event.key.keysym.sym);
         keyPressedMutex.unlock();
         break;
+      case SDL_WINDOWEVENT:
+        if (event.window.event == SDL_WINDOWEVENT_FOCUS_LOST) {
+          boost::mutex::scoped_lock lock(keyPressedMutex);
+          keyPressed.clear();
+        }
+        break;
       case SDL_MOUSEBUTTONDOWN:
         mousePressedMutex.lock();
         mousePressed[event.button.button] = true;
