+int main(int argc, const char** argv) {
+#ifdef __APPLE__
+  // Cocoa requires SDL video, window creation and event pumping on this thread.
+  if (SDL_Init(SDL_INIT_VIDEO) != 0) {
+    fprintf(stderr, "SDL video initialization failed: %s\n", SDL_GetError());
+    return 1;
+  }
+
+  int gameResult = 1;
+  boost::thread gameThread([&]() {
+    gameResult = RunGame(argc, argv);
+  });
+
+  blunted::Renderer3D *renderer = blunted::WaitForMainThreadRenderer();
+  (*renderer)();
+  blunted::NotifyMainThreadRendererStopped();
+  gameThread.join();
+  SDL_Quit();
+  return gameResult;
+#else
+  return RunGame(argc, argv);
+#endif
+}
