+void Match::ApplyLanAuthority(int homeScore, int awayScore, e_MatchPhase phase,
+                              unsigned long time_ms, bool playing, bool setPiece,
+                              bool scored) {
+  if (matchPhase != phase) SetMatchPhase(phase);
+  matchTime_ms = time_ms;
+  if (matchData->GetGoalCount(0) != homeScore) {
+    matchData->SetGoalCount(0, homeScore);
+    scoreboard->SetGoalCount(0, homeScore);
+  }
+  if (matchData->GetGoalCount(1) != awayScore) {
+    matchData->SetGoalCount(1, awayScore);
+    scoreboard->SetGoalCount(1, awayScore);
+  }
+  inPlay = playing;
+  inSetPiece = setPiece;
+  SetGoalScored(scored);
+}
