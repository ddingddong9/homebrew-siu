+
+bool HumanoidBase::SetLanRenderPose(int animationID, int frame, const Vector3 &position,
+                                    radian orientation, bool noPos, const Vector3 &movement) {
+  if (animationID < 0 || animationID >= int(anims->GetAnimations().size())) return false;
+  Animation *animation = anims->GetAnim(animationID);
+  if (frame < 0 || frame >= animation->GetFrameCount()) return false;
+  lanRenderPose.anim = animation;
+  lanRenderPose.frameNum = frame;
+  lanRenderPose.position = position;
+  lanRenderPose.orientation = orientation;
+  lanRenderPose.noPos = noPos;
+  lanRenderPose.smooth = false;
+  lanPoseMovement = movement;
+  lanRenderPoseAge = 0;
+  lanRenderPoseActive = true;
+  return true;
+}
 
